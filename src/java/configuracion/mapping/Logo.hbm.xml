<hibernate-mapping>
    <class name="configuracion.modelos.Logo" table="LOGOS"
            dynamic-insert="true"
        dynamic-update="true">
            
        <id name="id" type="integer" column="ID_LOGO">
            <generator class="assigned" />
        </id>
        
        <property name="logo" type="blob" >              
            <column name="LOGO" length="150000"/>
        </property>
        
    </class>
</hibernate-mapping>

