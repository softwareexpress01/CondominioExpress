				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nombBanco}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="240" y="1" width="60" height="15"/>
